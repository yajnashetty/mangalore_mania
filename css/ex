  <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
  <style>
    html {
      scroll-behavior: smooth;
    }
    header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    padding: 20px 10px;
    font-family: 'Pacifico', cursive;
    font-size: 2.5rem;
    background: rgba(0, 0, 0, 0.4);
    color: #ffe082;
    }

.logo {
  height: 60px;
  width: auto;
}


    body {
      margin: 0;
      padding: 0;
      font-family: 'Poppins', sans-serif;
      color: #fff;
      background-image: url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e'); /* Tropical sunset */
      background-size: cover;
      background-attachment: fixed;
      background-position: center;
      text-shadow: 1px 1px 4px #000;
    }

    body::before {
      content: "";
      position: fixed;
      top: 0;
      left: 0;
      height: 100%;
      width: 100%;
      background: linear-gradient(to bottom, rgba(0,0,0,0.6), rgba(0,0,0,0.7));
      z-index: -1;
    }

    header {
      font-family: 'Pacifico', cursive;
      font-size: 2.5rem;
      text-align: center;
      padding: 20px 10px;
      background: rgba(0, 0, 0, 0.4);
      color: #ffe082;
    }

    nav {
      background-color: rgba(0, 0, 0, 0.5);
      text-align: center;
      padding: 12px;
    }

    nav a {
      margin: 0 20px;
      color: #ffeb3b;
      font-weight: bold;
      text-decoration: none;
      transition: color 0.3s ease;
    }

    nav a:hover {
      color: #ffd54f;
      text-decoration: underline;
    }

    .intro-text {
      text-align: center;
      padding: 3rem 2rem 1rem;
    }

    .intro-text h2 {
      font-size: 2.8rem;
      color: #fff176;
      margin-bottom: 10px;
    }

    .intro-text p {
      max-width: 800px;
      margin: 0 auto;
      font-size: 1.2rem;
      color: #fffde7;
    }

    .explore-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 30px;
      padding: 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .place-card {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(12px);
      border-radius: 15px;
      overflow: hidden;
      box-shadow: 0 8px 20px rgba(0,0,0,0.4);
      transition: transform 0.4s ease, box-shadow 0.4s ease;
    }

    .place-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 24px rgba(255, 235, 59, 0.6);
    }

    .place-card img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }

    .place-info {
      padding: 15px;
    }

    .place-info h3 {
      margin-top: 0;
      color: #ffeb3b;
    }

    .place-info p {
      font-size: 0.95rem;
      color: #fefefe;
    }

    footer {
      text-align: center;
      padding: 20px;
      background-color: rgba(0, 0, 0, 0.5);
      font-size: 0.9em;
      color: #fff;
      margin-top: 40px;
    }
  </style>
</head>
<body>

 <header>
  <a href="index.html">
    <img src="images/lv4.png" class="logo" alt="Mangalore Mania Logo" />
  </a>
  <span>Mangalore Mania</span>
</header>



  <nav>
    <a href="index.html">Home</a>
    <a href="explore.html">Explore</a>
    <a href="events.html">Events</a>
    <a href="food.html">Food</a>
    <a href="contact.html">Contact</a>
  </nav>

  <section class="intro-text">
    <h2 data-aos="fade-up">Explore Mangalore</h2>
    <p data-aos="fade-up">
      Discover the charm of the coastal city — from heritage temples to serene beaches, there’s something for every explorer.
    </p>
  </section>

  <div class="explore-container">
    <div class="place-card" data-aos="fade-right">
      <img src="images/panambur.png" alt="Panambur Beach" />
      <div class="place-info">
        <h3>Panambur Beach</h3>
        <p>Enjoy camel rides, kite festivals, and stunning sunsets.</p>
      </div>
    </div>

    <div class="place-card" data-aos="fade-left">
      <img src="images/kadri.jpg" alt="Kadri Manjunath Temple" />
      <div class="place-info">
        <h3>Kadri Manjunath Temple</h3>
        <p>One of the oldest temples in South India, rich in heritage and beauty.</p>
      </div>
    </div>

    <div class="place-card" data-aos="fade-right">
      <img src="images/pilikula.jpg" alt="Pilikula Nisargadhama" />
      <div class="place-info">
        <h3>Pilikula Nisargadhama</h3>
        <p>A nature and science park with zoo, lake, and heritage village.</p>
      </div>
    </div>

    <div class="place-card" data-aos="fade-left">
      <img src="images/Tannirbhavi.jpg" alt="Tannirbhavi Beach" />
      <div class="place-info">
        <h3>Tannirbhavi Beach</h3>
        <p>Unwind with sea breeze, sunset views, and long coastal walks.</p>
      </div>
    </div>

    <div class="place-card" data-aos="fade-right">
      <img src="images/alo.jpeg" alt="St. Aloysius Chapel" />
      <div class="place-info">
        <h3>St. Aloysius Chapel</h3>
        <p>Admire 19th-century Italian-style frescoes and stained glass art.</p>
      </div>
    </div>

    <div class="place-card" data-aos="fade-left">
      <img src="assets/market.jpg" alt="Central Market" />
      <div class="place-info">
        <h3>Central Market</h3>
        <p>A lively market for fresh produce, spices, and coastal delicacies.</p>
      </div>
    </div>
  </div>
  <section style="padding: 2rem; text-align: center; z-index: 3; position: relative;">
  <h2 style="color: #ffe082;">Explore Mangalore on Map</h2>
  <p style="color: #fffde7;">See Mangalore’s most loved spots, beaches, and cultural heritage on the map.</p>

